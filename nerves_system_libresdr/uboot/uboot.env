nerves_fw_active=a
nerves_fw_validated=1
nerves_fw_devpath=/dev/mmcblk0
nerves_serial_number=
upgrade_available=0
bootcount=0
bootlimit=1
a.nerves_fw_application_part0_devpath=/dev/mmcblk0p4
a.nerves_fw_application_part0_fstype=f2fs
a.nerves_fw_application_part0_target=/root
b.nerves_fw_application_part0_devpath=/dev/mmcblk0p4
b.nerves_fw_application_part0_fstype=f2fs
b.nerves_fw_application_part0_target=/root
kernel_addr_r=0x3000000
fdt_addr_r=0x2A00000
nerves_revert=echo "NERVES: boot failed ${bootcount} times, reverting"; if test "${nerves_fw_active}" = "a"; then setenv nerves_fw_active b; else setenv nerves_fw_active a; fi; setenv bootcount 0; setenv upgrade_available 0; saveenv
nerves_bootcount=if test "${upgrade_available}" = "1"; then setexpr bootcount ${bootcount} + 1; saveenv; if test ${bootcount} -gt ${bootlimit}; then run nerves_revert; fi; fi
nerves_boot=if test "${nerves_fw_active}" = "b"; then setenv slot b; setenv rootpart 3; else setenv slot a; setenv rootpart 2; fi; echo "NERVES: slot ${slot}, rootfs /dev/mmcblk0p${rootpart}"; setenv bootargs console=ttyPS0,115200 root=/dev/mmcblk0p${rootpart} rootfstype=squashfs ro rootwait; load mmc 0:1 ${kernel_addr_r} uImage.${slot} && load mmc 0:1 ${fdt_addr_r} zynq-libresdr.${slot}.dtb && bootm ${kernel_addr_r} - ${fdt_addr_r}
bootcmd=run nerves_bootcount; run nerves_boot
