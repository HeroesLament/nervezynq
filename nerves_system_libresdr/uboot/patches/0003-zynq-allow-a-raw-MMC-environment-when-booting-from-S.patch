From 09b62f5602ecaeef5c61ac4da1d59b25293f2936 Mon Sep 17 00:00:00 2001
From: HeroesLament <heroeslament@nunyabiz.net>
Date: Mon, 28 Sep 2026 18:29:34 -0800
Subject: [PATCH 3/4] zynq: allow a raw MMC environment when booting from SD

env_get_location() only offers FAT or ext4 for SD boot, so a board that
keeps its environment at a raw offset on the SD card (CONFIG_ENV_IS_IN_MMC,
as Nerves' fwup layout does) gets ENVL_NOWHERE and boots on the default
environment. Return ENVL_MMC first when it is enabled.
---
 board/xilinx/zynq/board.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/board/xilinx/zynq/board.c b/board/xilinx/zynq/board.c
index a852d5b8..595b09cf 100644
--- a/board/xilinx/zynq/board.c
+++ b/board/xilinx/zynq/board.c
@@ -143,6 +143,8 @@ enum env_location env_get_location(enum env_operation op, int prio)
 
 	switch (bootmode) {
 	case ZYNQ_BM_SD:
+		if (IS_ENABLED(CONFIG_ENV_IS_IN_MMC))
+			return ENVL_MMC;
 		if (IS_ENABLED(CONFIG_ENV_IS_IN_FAT))
 			return ENVL_FAT;
 		if (IS_ENABLED(CONFIG_ENV_IS_IN_EXT4))
