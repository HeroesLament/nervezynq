# boardid.config
#
# The serial number is burned into the U-Boot environment by fwup
# (NERVES_SERIAL_NUMBER -> nerves_serial_number, see fwup_include/provisioning.conf).
# "serial_number" is checked as a backup.
-b uboot_env -u nerves_serial_number
-b uboot_env -u serial_number

# Fallback for an unprovisioned card: the MAC address of the first Ethernet port.
-b macaddr
